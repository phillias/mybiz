# build output
dist/
.astro/

# dependencies
node_modules/

# env files (real secrets never committed; .env.example is the template)
.env
.env.*
!.env.example

# convex local data
.convex/
convex/_generated/

# logs
npm-debug.log*
*.log
.wrangler/

# editor
.DS_Store
.idea/
.vscode/

# OmO: track omo.jsonc + plans/drafts; ignore runtime state
.omo/runtime/
.omo/evidence/
.omo/worktrees/
.omo/run-continuation/
.omo/boulder.json
.omo/state/
.omo/locks/
.omo/*.log

# envsitter tool state (contains a security pepper — never commit)
.envsitter/

# generated content drafts (scripts/generate-article.mjs output)
content/drafts/

# generated prospect leads (scripts/prospect-score.mjs output; PII — never commit)
content/prospects/*.tsv
content/prospects/*.json
!content/prospects/fixture.json

# harbor key file (never commit)
.harbor-key

# repo-local tooling (never ships in the production bundle)
.tools/

# generated telemetry command files (opencode-telemetry plugin rewrites these per-project)
.opencode/commands/telemetry-*.md
