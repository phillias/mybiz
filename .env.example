# ============================================================
# Harbor — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# --- Astro / Cloudflare Pages ---
# Public site URL (used for absolute links, sitemap, canonical)
# Commercial/professional domain per the 2026-08-24 cutover; phillias.us is
# retained non-commercially (see docs/codevex-migration-runbook.md).
# NOTE: the Cloudflare Pages production secret must be updated at deploy time:
# dash.cloudflare.com → Workers & Pages → mybiz → Settings → Variables & Secrets.
PUBLIC_SITE_URL=https://codevex.app
# Business contact email published on pages and CTIA records. Consumed via
# src/config/site.ts (default lives there); mailbox provisioning is a runbook item.
PUBLIC_CONTACT_EMAIL=admin@codevex.app

# Headless deploy auth (scripts/deploy-pages.sh): token needs
# Account.Cloudflare Pages:Edit; Zone codevex.app DNS:Edit for the custom domain
# (phillias.us zone stays live for legacy redirect/mail forwarding).
# Create at dash.cloudflare.com → My Profile → API Tokens.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Convex ---
# Deploy URL shown in `npx convex deploy` output / Convex dashboard
# (current prod: https://moonlit-spider-468.convex.cloud)
PUBLIC_CONVEX_URL=https://<your-project>.convex.site
# Admin key (dashboard → Settings → Deploy Keys). NEVER expose publicly.
CONVEX_DEPLOY_KEY=

# --- Clerk (auth) ---
# Clerk dashboard → API Keys
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
# Clerk Frontend API URL — issuer for Convex token validation (convex/auth.config.ts)
CLERK_JWT_ISSUER_DOMAIN=https://<instance>.clerk.accounts.dev

# --- Cloudflare Turnstile (bot protection) ---
# Cloudflare dashboard → Turnstile → site/widget
PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAA...
TURNSTILE_SECRET=0x4AAAAAA...

# --- Resend (transactional email) ---
# resend.com → API Keys
RESEND_API_KEY=re_...
# Verified sender domain or address (e.g., no-reply@harborseo.ai)
RESEND_FROM=no-reply@harborseo.ai

# --- Stripe (payments, test mode first) ---
# dashboard.stripe.com → Developers → API keys (test mode)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Telnyx (voice + SMS) ---
# TELNYX_PUBLIC_KEY is the Ed25519 webhook verification key
# (Mission Control → API Keys → Public Key); webhooks are fail-closed when set.
TELNYX_API_KEY=KEY...
TELNYX_PUBLIC_KEY=SW+rtUKh...
# The provisioned number (E.164, e.g. +13175550123)
TELNYX_NUMBER=

# --- Harbor (harborseo.ai, third-party content-generation service) ---
# Only needed for the `harbor` MCP (project .opencode/opencode.json).
# Mint at harborseo.ai → dashboard → Devs. Consumes article credits.
HARBOR_API_KEY=

# --- Composio (GSC OAuth gateway) ---
# Headless MCP auth for Google Search Console tools.
# Get key at dashboard.composio.dev → AI Clients → copy consumer API key (ck_...).
# Only needed for the `composio` MCP (project .opencode/opencode.json).
COMPOSIO_API_KEY=

# --- Bench Studio (media generation bench) ---
# Only needed for the `bench-studio` MCP (project .opencode/opencode.json),
# which runs {env:HOME}/docker/bench-studio/server/mcp.mjs.
# Export these in the opencode process env (not just .env), like HARBOR_API_KEY.
BENCH_URL=https://bench.phillias.cc
BENCH_PASSWORD=

# --- U3 niche validation (DataForSEO SERP API) ---
# Gate: sponsoredCount == 0, no map-pack, >= 3 low-competition long-tail clusters.
# DATAFORSEO_API_KEY = base64("email:password") from dataforseo.com, sent as the
# Basic auth header. Must be set on the Convex deployment:
#   npx convex env set DATAFORSEO_API_KEY <base64> --prod
DATAFORSEO_API_KEY=
