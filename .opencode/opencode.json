{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "harbor": {
      "type": "remote",
      "url": "https://outgoing-oyster-428.convex.site/mcp",
      "headers": {
        "Authorization": "Bearer {env:HARBOR_API_KEY}"
      },
      "enabled": true
    },
    "convex": {
      "type": "local",
      "command": ["npx", "-y", "convex@latest", "mcp", "start"],
      "enabled": true
    }
  }
}
