{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "harbor": {
      "type": "remote",
      "url": "https://outgoing-oyster-428.convex.site/mcp",
      "headers": {
        "Authorization": "Bearer {env:HARBOR_API_KEY}"
      },
      "enabled": true
    },
    "convex": {
      "type": "local",
      "command": ["npx", "-y", "convex@latest", "mcp", "start"],
      "enabled": true
    },
    "composio": {
      "type": "remote",
      "url": "https://connect.composio.dev/mcp",
      "headers": {
        "x-consumer-api-key": "{env:COMPOSIO_API_KEY}"
      },
      "enabled": true
    },
    "bench-studio": {
      "type": "local",
      "command": ["node", "{env:HOME}/docker/bench-studio/server/mcp.mjs"],
      "environment": {
        "BENCH_URL": "https://bench.phillias.cc",
        "BENCH_PASSWORD": "{env:BENCH_PASSWORD}"
      },
      "enabled": true
    }
  }
}
