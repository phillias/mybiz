---
// U1: protected route — middleware redirects anonymous users to /sign-in.
// Without env keys this 500s at runtime (expected until .env is filled).
// Auth-gated app surface: noindex and excluded from the sitemap (audit F12).
import BaseLayout from "../layouts/BaseLayout.astro";

const userId = Astro.locals.auth?.userId ?? null;
---

<BaseLayout title="Harbor — App" description="The Phileas Fogg content workspace." path="/app/" robots="noindex, follow">
  <main style="max-width: 720px; margin: 0 auto; padding: 2rem 1rem">
    <h1>Workspace</h1>
    {userId ? (
      <p>Signed in as <code>{userId}</code>. Blueprint + niche tables land in U3/U4.</p>
    ) : (
      <p>Not signed in — <a href="/sign-in">sign in</a>.</p>
    )}
  </main>
</BaseLayout>
